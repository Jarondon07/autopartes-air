# === Plantilla de variables de entorno ===
#
# Copiar a:
#   - .env.local  → desarrollo (se carga cuando NODE_ENV != production)
#   - .env        → producción (se carga cuando NODE_ENV = production)
#
# Ambos archivos están en .gitignore. Nunca commitear secretos reales.

# Servidor (rango de puertos asignado al proyecto: 4300-4399)
PORT=4300
NODE_ENV=development
CORS_ORIGIN=http://localhost:4301

# Base de datos
DATABASE_URL=postgresql://postgres:CAMBIAR_PASSWORD@localhost:5432/autopartes-air

# JWT — generar secretos propios para producción
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_ACCESS_SECRET=cambiar-por-secreto-largo-y-aleatorio-access
JWT_REFRESH_SECRET=cambiar-por-secreto-largo-y-aleatorio-refresh
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d

# `secure` de la cookie del refresh token. Vacío = sigue a NODE_ENV.
#   false → producción servida por HTTP (acceso por IP, sin dominio ni TLS).
#           Con true sobre HTTP el navegador descarta la cookie y la sesión
#           se corta al vencer el access token (15 min).
#   true  → producción con HTTPS (lo correcto una vez montado el certificado).
COOKIE_SECURE=

# Worker de tasa BCV automática (opcional)
# Sin RADAR_API_KEY el worker no se activa y la tasa se carga solo manualmente.
RADAR_API_URL=https://radar.revolut.team/api/rates
RADAR_API_KEY=
# Hora local (HH:MM) de la consulta diaria automática a Radar.
BCV_FETCH_TIME=00:30
BCV_FALLBACK_RATE=36
