# === Plantilla de variables de entorno ===
#
# Copiar a:
#   - .env.local  → desarrollo (se carga cuando NODE_ENV != production)
#   - .env        → producción (se carga cuando NODE_ENV = production)
#
# Ambos archivos están en .gitignore. Nunca commitear secretos reales.

# Servidor
PORT=3000
NODE_ENV=development
CORS_ORIGIN=http://localhost:5173

# Base de datos
DATABASE_URL=postgresql://postgres:CAMBIAR_PASSWORD@localhost:5432/autoparte_air

# JWT — generar secretos propios para producción
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_ACCESS_SECRET=cambiar-por-secreto-largo-y-aleatorio-access
JWT_REFRESH_SECRET=cambiar-por-secreto-largo-y-aleatorio-refresh
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d
